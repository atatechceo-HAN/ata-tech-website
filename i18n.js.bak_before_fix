 */
window.toggleDesktopLangDropdown = toggleDesktopLangDropdown;
function toggleDesktopLangDropdown(e) {
    if (e) {
        e.stopPropagation();
        e.preventDefault();
    }
    const dropdown = document.getElementById('desktop-lang-dropdown');
    if (dropdown) {
        dropdown.classList.remove('menu-temporarily-closed');
        const isActive = dropdown.classList.contains('active-dropdown');
        if (isActive) {
            dropdown.classList.remove('active-dropdown');
            dropdown.classList.add('menu-temporarily-closed');
        } else {
            dropdown.classList.add('active-dropdown');
        }
    }
}

window.closeDesktopLangDropdown = closeDesktopLangDropdown;
function closeDesktopLangDropdown(byUserSelection) {
    const dropdown = document.getElementById('desktop-lang-dropdown');
    if (dropdown) {
        dropdown.classList.remove('active-dropdown');
        if (byUserSelection) {
            dropdown.classList.add('menu-temporarily-closed');
        } else {
            dropdown.classList.remove('menu-temporarily-closed');
        }
    }
}

/**
 * 모바일 언어 드롭다운 토글
 */
window.toggleMobileLangDropdown = toggleMobileLangDropdown;
function toggleMobileLangDropdown(e) {
    if (e) {
        e.stopPropagation();
        e.preventDefault();
    }
    const dropdown = document.getElementById('mobile-lang-dropdown');
    if (dropdown) {
        const isHidden = dropdown.classList.contains('hidden') || dropdown.style.display === 'none';
        if (isHidden) {
            dropdown.classList.remove('hidden');
            dropdown.style.display = 'block';
            dropdown.style.pointerEvents = 'auto';
            dropdown.style.visibility = 'visible';
            dropdown.style.zIndex = '300';
        } else {
            closeMobileLangDropdown();
        }
    }
}

window.closeMobileLangDropdown = closeMobileLangDropdown;
function closeMobileLangDropdown() {
    const dropdown = document.getElementById('mobile-lang-dropdown');
    if (dropdown) {
        dropdown.classList.add('hidden');
        dropdown.style.display = 'none';
        dropdown.style.pointerEvents = 'none';
        dropdown.style.visibility = 'hidden';
        dropdown.style.zIndex = '-9999';
    }
}

// 마우스 호버 이탈 시 지연 처리 (마우스 이동 중 꺼짐 완벽 방지)
let desktopLangCloseTimer = null;
function initDesktopLangHover() {
    const dContainer = document.getElementById('desktop-lang-container');
    const dDropdown = document.getElementById('desktop-lang-dropdown');
    if (dContainer && dDropdown) {
        dContainer.addEventListener('mouseenter', function() {
            if (desktopLangCloseTimer) {
                clearTimeout(desktopLangCloseTimer);
                desktopLangCloseTimer = null;
            }
            dDropdown.classList.remove('menu-temporarily-closed');
        });

        dContainer.addEventListener('mouseleave', function() {
            if (desktopLangCloseTimer) {
                clearTimeout(desktopLangCloseTimer);
            }
            desktopLangCloseTimer = setTimeout(function() {
                if (!dDropdown.classList.contains('active-dropdown')) {
                    dDropdown.classList.remove('menu-temporarily-closed');
                }
            }, 180);
        });
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initDesktopLangHover);
} else {
    initDesktopLangHover();
}

// 바깥 클릭 시 모든 언어 드롭다운 닫기
document.addEventListener('click', function (e) {
    const dContainer = document.getElementById('desktop-lang-container');
    if (dContainer && !dContainer.contains(e.target)) {
        closeDesktopLangDropdown(false);
    }
    const mBtn = document.getElementById('mobile-lang-btn');
    const mDropdown = document.getElementById('mobile-lang-dropdown');
    if (mDropdown && !mDropdown.classList.contains('hidden') && mDropdown.style.display !== 'none') {
        if (mBtn && !mBtn.contains(e.target) && !mDropdown.contains(e.target)) {
            closeMobileLangDropdown();
        }
    }
});

// ESC 키 입력 시 닫기
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        closeDesktopLangDropdown(false);
        closeMobileLangDropdown();
