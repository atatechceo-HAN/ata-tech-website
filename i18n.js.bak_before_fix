    }
    // 2. Exact key match
    for (var i = 0; i < productCatalog.length; i++) {
        var p = productCatalog[i];
        for (var j = 0; j < p.keys.length; j++) {
            if (p.keys[j].toLowerCase() === q) return p;
        }
    }
    // 3. Substring match
    for (var i = 0; i < productCatalog.length; i++) {
        var p = productCatalog[i];
        for (var j = 0; j < p.keys.length; j++) {
            var k = p.keys[j].toLowerCase();
            if (k.indexOf(q) !== -1 || q.indexOf(k) !== -1) {
                return p;
            }
        }
    }
    return productCatalog[0];
};

